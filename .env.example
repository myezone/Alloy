# Russ Community Credit Union (Demo) settings
# Copy this file to ".env" and fill in the two blank values.
# The .env file stays on your machine. Never commit it or paste it into a chat.

# Alloy sandbox endpoint for your account (from the workflow's API Resources panel)
ALLOY_BASE_URL=

# Journey token (Alloy dashboard > Journeys)
ALLOY_JOURNEY_TOKEN=

# Workflow token and secret: Alloy dashboard > Settings > API Keys > "Fraud & CIP (LexisNexis)" row
ALLOY_WORKFLOW_TOKEN=
ALLOY_WORKFLOW_SECRET=

# Public SDK key: Alloy dashboard > Settings > SDK
ALLOY_SDK_KEY=

# Added in front of every test applicant's first name, so you can find your
# applications in the shared Application Queue. Example: RI
TEST_NAME_PREFIX=RI

# Set to true to force simulated responses even when credentials are present
MOCK_MODE=false

# Required when the app is online: any username, this password
DEMO_PASSWORD=

PORT=3000
